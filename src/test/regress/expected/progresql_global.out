-- P1-1: explicit GLOBAL syntax for cross-partition (spanning) UNIQUE/PK.
--
-- GLOBAL is the declarative opt-in that replaces the implicit
-- "INHERITS + PARTITION BY + PK/UNIQUE" handshake.  It is supported three ways:
--   1. table constraint:   PRIMARY KEY (...) GLOBAL / UNIQUE (...) GLOBAL
--   2. standalone index:   CREATE UNIQUE INDEX ... ON root (...) GLOBAL
--   3. ALTER TABLE ADD CONSTRAINT ... {PRIMARY KEY|UNIQUE} (...) GLOBAL
-- None of these require a base table / INHERITS.  GLOBAL is an existing
-- unreserved keyword, so it adds no keyword cost.
-- Section 1: PRIMARY KEY (...) GLOBAL in CREATE TABLE (no INHERITS)
CREATE TABLE pg_events (id bigint NOT NULL, ts timestamptz NOT NULL,
    PRIMARY KEY (id) GLOBAL) PARTITION BY RANGE (ts);
CREATE TABLE pg_events_2024 PARTITION OF pg_events
    FOR VALUES FROM ('2024-01-01') TO ('2025-01-01');
CREATE TABLE pg_events_2025 PARTITION OF pg_events
    FOR VALUES FROM ('2025-01-01') TO ('2026-01-01');
-- it is a spanning index (indnuniqatts > 0)
SELECT indnuniqatts > 0 AS is_spanning
  FROM pg_index WHERE indexrelid = 'pg_events_pkey'::regclass;
 is_spanning 
-------------
 t
(1 row)

INSERT INTO pg_events VALUES (1, '2024-06-01');
-- cross-partition duplicate must be rejected
INSERT INTO pg_events VALUES (1, '2025-06-01');  -- expect ERROR
ERROR:  duplicate key value violates unique constraint "pg_events_pkey"
DETAIL:  Key (id)=(1) already exists.
-- distinct key in another partition is fine
INSERT INTO pg_events VALUES (2, '2025-06-01');
SELECT id FROM pg_events ORDER BY id;
 id 
----
  1
  2
(2 rows)

-- Section 2: standalone CREATE UNIQUE INDEX ... GLOBAL
CREATE TABLE pg_codes (id bigint NOT NULL, code text, ts timestamptz NOT NULL)
    PARTITION BY RANGE (ts);
CREATE TABLE pg_codes_2024 PARTITION OF pg_codes
    FOR VALUES FROM ('2024-01-01') TO ('2025-01-01');
CREATE TABLE pg_codes_2025 PARTITION OF pg_codes
    FOR VALUES FROM ('2025-01-01') TO ('2026-01-01');
CREATE UNIQUE INDEX pg_codes_gx ON pg_codes (code) GLOBAL;
SELECT indnuniqatts > 0 AS is_spanning
  FROM pg_index WHERE indexrelid = 'pg_codes_gx'::regclass;
 is_spanning 
-------------
 t
(1 row)

INSERT INTO pg_codes VALUES (1, 'abc', '2024-06-01');
INSERT INTO pg_codes VALUES (2, 'abc', '2025-06-01');  -- expect ERROR (cross-part dup)
ERROR:  duplicate key value violates unique constraint "pg_codes_gx"
DETAIL:  Key (code)=(abc) already exists.
-- NULLs are distinct across partitions (standard UNIQUE semantics)
INSERT INTO pg_codes VALUES (3, NULL, '2024-07-01');
INSERT INTO pg_codes VALUES (4, NULL, '2025-07-01');
SELECT count(*) AS null_codes FROM pg_codes WHERE code IS NULL;
 null_codes 
------------
          2
(1 row)

-- Section 3: UNIQUE (...) GLOBAL table constraint
CREATE TABLE pg_sku (id bigint, sku text NOT NULL, ts timestamptz NOT NULL,
    UNIQUE (sku) GLOBAL) PARTITION BY RANGE (ts);
SELECT count(*) AS spanning_indexes
  FROM pg_index WHERE indrelid = 'pg_sku'::regclass AND indnuniqatts > 0;
 spanning_indexes 
------------------
                1
(1 row)

-- Section 4: ALTER TABLE ADD CONSTRAINT ... PRIMARY KEY (...) GLOBAL
CREATE TABLE pg_alt (id bigint NOT NULL, ts timestamptz NOT NULL)
    PARTITION BY RANGE (ts);
CREATE TABLE pg_alt_2024 PARTITION OF pg_alt
    FOR VALUES FROM ('2024-01-01') TO ('2025-01-01');
ALTER TABLE pg_alt ADD CONSTRAINT pg_alt_pk PRIMARY KEY (id) GLOBAL;
SELECT indnuniqatts > 0 AS is_spanning
  FROM pg_index WHERE indexrelid = 'pg_alt_pk'::regclass;
 is_spanning 
-------------
 t
(1 row)

-- Section 5: GLOBAL on a plain ordinary table is accepted -- it declares a
-- spanning root that spans itself until descendants (partitions or INHERITS
-- children) are added.  This is the root-first DDL pattern: the spanning PK is
-- created before any children exist, then children INHERIT and are backfilled.
CREATE TABLE pg_plain (id bigint NOT NULL, PRIMARY KEY (id) GLOBAL);   -- OK: spanning root (no children yet)
INSERT INTO pg_plain VALUES (1);
INSERT INTO pg_plain VALUES (1);                                       -- ERROR: enforced on its own rows
ERROR:  duplicate key value violates unique constraint "pg_plain_pkey"
DETAIL:  Key (id)=(1) already exists.
CREATE TABLE pg_plain2 (id bigint);
CREATE UNIQUE INDEX ON pg_plain2 (id) GLOBAL;                          -- OK: spanning root
-- Multi-level partitioning under a spanning index is rejected at DDL time:
-- every partition must be a leaf (the partseq map keys leaves, not interior
-- nodes).  This forbids the untested grandchild-leaf case by construction.
CREATE TABLE pg_ml (id bigint NOT NULL, ts timestamptz NOT NULL, region text NOT NULL,
    PRIMARY KEY (id) GLOBAL) PARTITION BY RANGE (ts);
CREATE TABLE pg_ml_2024 PARTITION OF pg_ml
    FOR VALUES FROM ('2024-01-01') TO ('2025-01-01')
    PARTITION BY LIST (region);                                        -- ERROR: cannot sub-partition
ERROR:  cannot sub-partition a partition of a table with a spanning (GLOBAL) index
DETAIL:  Spanning index "pg_ml_pkey" does not support multi-level partitioning; every partition must be a leaf.
-- ATTACHing an already-partitioned table to a spanning root is rejected for the
-- same reason (its grandchildren would have no partseq and escape the index).
CREATE TABLE pg_ml2 (id bigint NOT NULL, ts timestamptz NOT NULL,
    PRIMARY KEY (id) GLOBAL) PARTITION BY RANGE (ts);
CREATE TABLE pg_ml2_sub (id bigint NOT NULL, ts timestamptz NOT NULL)
    PARTITION BY RANGE (ts);
ALTER TABLE pg_ml2 ATTACH PARTITION pg_ml2_sub
    FOR VALUES FROM ('2024-01-01') TO ('2025-01-01');                  -- ERROR: cannot attach a partitioned table
ERROR:  cannot attach a partitioned table as a partition of a table with a spanning (GLOBAL) index
DETAIL:  Spanning index "pg_ml2_pkey" requires every partition to be a leaf.
-- Cleanup
DROP TABLE pg_events;
DROP TABLE pg_codes;
DROP TABLE pg_sku;
DROP TABLE pg_alt;
DROP TABLE pg_plain;
DROP TABLE pg_plain2;
DROP TABLE pg_ml;
DROP TABLE pg_ml2;
DROP TABLE pg_ml2_sub;
-- Fork identity: progresql_version() is the supported public hook for client
-- tooling to detect the ProgreSQL fork (vanilla reports the same server_version)
-- and gate features.  Present in every cluster -- no GLOBAL objects required.
SELECT progresql_version();
 progresql_version 
-------------------
 0.2.8
(1 row)

SELECT to_regproc('progresql_version') IS NOT NULL AS is_progresql;
 is_progresql 
--------------
 t
(1 row)

-- pg_index_is_global() recovers GLOBAL from an existing index (the supported
-- introspection hook for the schema-dump round-trip), so clients need not read
-- the internal indnuniqatts key-padding.  NULL for a non-index argument.
CREATE TABLE g (id int NOT NULL, k int NOT NULL, PRIMARY KEY (id) GLOBAL) PARTITION BY LIST (k);
CREATE INDEX g_local ON g (k);
SELECT pg_index_is_global('g_pkey'::regclass)  AS pk_is_global,
       pg_index_is_global('g_local'::regclass) AS local_is_global,
       pg_index_is_global('g'::regclass)        AS table_arg_is_null;
 pk_is_global | local_is_global | table_arg_is_null 
--------------+-----------------+-------------------
 t            | f               | 
(1 row)

-- pg_index_global_columns() returns the user-facing columns (excludes the
-- partseq discriminator that crashes stock catalog introspection).
SELECT pg_index_global_columns('g_pkey'::regclass)  AS pk_user_cols,
       pg_index_global_columns('g_local'::regclass) AS local_cols,
       pg_index_global_columns('g'::regclass)        AS table_arg_is_null;
 pk_user_cols | local_cols | table_arg_is_null 
--------------+------------+-------------------
 {id}         | {k}        | 
(1 row)

DROP TABLE g;
